Meta.DisplayName=Rust (TeamKit) - recommandé
Meta.Description=Serveur dédié Rust prêt pour un gros PvP : joueurs visibles dans AMP, console d'AMP reliée au serveur, mot de passe RCON obligatoire et hors de la ligne de commande, wipe réglable avec archive datée, arrêt propre avec sauvegarde, Oxide et plugins uMod en cases à cocher (groupe PvP compétitif), plugins figés pendant une saison.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Rust
Meta.DisplayImageSource=steam:252490
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$GamePort}
Meta.ConfigManifest=rustteamkitconfig.json
Meta.MetaConfigManifest=rustteamkitmetaconfig.json
Meta.ConfigRoot=rustteamkit.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Le lanceur TeamKit est en Python 3 (sans bibliothèque en plus) et télécharge les plugins avec curl : ExtraContainerPackages les garantit dans le conteneur Debian 13. Hors conteneur, python3 et curl doivent être installés sur la machine.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3","curl","ca-certificates"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=8
Meta.ReleaseNotes=v8 : modèle recommandé pour le PvP. Mot de passe RCON obligatoire et passé par un fichier ; console d'AMP reliée au serveur par RCON local ; arrêt propre (server.save puis quit) ; wipe au prochain démarrage ou automatique selon le rythme, avec archive datée ; Rust+ (adresse publique), logo, taille d'équipe, tickrate ; groupe de plugins PvP compétitif ; plugins figés pendant une saison.
Meta.BreakingReleaseNotes=v8 : le mot de passe RCON est obligatoire (12 caractères ou plus) et le démarrage est refusé sans lui. Une instance v7 existante ne reçoit pas le nouveau lanceur : recréer l'instance (ou recopier App.* et lancer Update).
Meta.AppConfigId=36b0971a-67f7-4e19-86cc-731858e5a6c6
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.DisplayName=Rust (TeamKit)
App.RootDir=./rust/
App.BaseDirectory=./rust/258550/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/usr/bin/python3
App.WorkingDir=258550
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-u "{{$FullBaseDir}}lancer-rust.py" lancer {{$GamePort}} {{$QueryPort}} {{$RconPort}} {{$RustPlusPort}} {{$MaxUsers}} {{CustomServerArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}RustDedicated_Data/Plugins/x86_64:{{$FullBaseDir}}:%LD_LIBRARY_PATH%","TERM":"xterm","SteamAppId":"252490","DOORSTOP_ENABLED":"0"}
App.CommandLineParameterFormat=+{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=200
App.ExitString=quit
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0

App.Ports=@IncludeJson[rustteamkitports.json]

App.AdminPortRef=RconPort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=QueryPort
App.MaxUsers=150
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=0
App.RCONConnectRetrySeconds=0
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default

App.UpdateSources=@IncludeJson[rustteamkitupdates.json]

App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.json","*.txt","*.sav","*.db","*.map"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=RustDedicated
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch

Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=(Filename:|UnloadTime|Unloading [0-9]+ unused|Total: [0-9\.]+ ms|Kinematic body only supports|Particle System is trying)
Console.AppReadyRegex=^Server startup complete$
Console.UserJoinRegex=^(?:(?<username>.+?) with steamid (?<userid>\d+) joined from ip (?<ip>[\d\.]+):\d+ with platform .*|(?<ip>[\d\.]+):\d+\/(?<userid>\d+)\/(?<username>.+?) joined \[.*\])$
Console.UserLeaveRegex=^[\d\.]+:\d+\/(?<userid>\d+)\/(?<username>.+?) disconnecting: .*$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=(Filename:|UnloadTime|Unloading [0-9]+ unused)
Console.SuppressLogAtStart=False
Console.UserActions={}

Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=60
